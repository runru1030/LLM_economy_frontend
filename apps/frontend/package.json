{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TURBO=1 next dev --turbo -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "reporter": "biome check --reporter=summary",
    "openapi": "llm-economy-openapi -i http://127.0.0.1:8000/openapi.json -o src/lib/api-v1",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:coverage:changed-files": "vitest run --coverage --changed=main"
  },
  "dependencies": {
    "@llm-economy/openapi": "workspace:*",
    "@llm-economy/tailwind": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.16",
    "@uiw/react-md-editor": "^4.0.11",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "immer": "^11.1.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "next": "16.1.1",
    "openapi-fetch": "^0.12.0",
    "openapi-typescript-helpers": "^0.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "rehype-katex": "^7.0.1",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "tailwindcss": "4",
    "tw-animate-css": "^1.4.0"
  }
}
